# Contoh konfigurasi server staging (DIG-49). Salin menjadi `staging.env` di folder repository
# di server, isi nilainya, dan jangan di-commit (staging.env diabaikan git). Lihat docs/STAGING.md.

# Wajib. Password tanpa karakter @ : / ? # karena disisipkan ke DATABASE_URL.
POSTGRES_PASSWORD=
# Wajib, minimal 32 karakter: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=

APP_ENV=staging
WEB_PORT=8080
# Isi max-age=31536000 hanya setelah staging dilayani lewat HTTPS (DIG-206).
STRICT_TRANSPORT_SECURITY=
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=4
