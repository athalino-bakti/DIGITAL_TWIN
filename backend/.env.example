APP_NAME=Digital Twin PuTI API
DATABASE_URL=postgresql+psycopg://puti:puti_local@localhost:5432/digital_twin
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
APP_ENV=development
# Wajib diganti di staging/production. Buat dengan: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=dev-only-ganti-jwt-secret-key-di-env-minimal-32-karakter
ACCESS_TOKEN_EXPIRE_MINUTES=60
