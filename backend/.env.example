APP_NAME=Digital Twin PuTI API
# Konektor Trello API (DIG-119), opsional. Key dan token dari https://trello.com/app-key
TRELLO_API_ENABLED=false
TRELLO_API_KEY=
TRELLO_API_TOKEN=
# TeamGit (DIG-122/DIG-125), opsional. Token cukup berhak baca repository.
TEAMGIT_BASE_URL=
TEAMGIT_TOKEN=
# Job impor terjadwal (DIG-127 s.d. DIG-129), lihat docs/IMPORT_PIPELINE.md.
TRELLO_BOARD_IDS=
IMPORT_MAX_ATTEMPTS=3
IMPORT_RETRY_DELAY_SECONDS=60
IMPORT_STALE_MINUTES=120
LOG_FORMAT=text
LOG_LEVEL=INFO
# Rahasia: incoming webhook Slack/Discord/Google Chat/Mattermost. Kosong = tanpa notifikasi.
NOTIFY_WEBHOOK_URL=
# Opsional: folder berisi satu berkas per rahasia (mis. /run/secrets), lihat docs/SECRETS.md.
SECRETS_DIR=
DATABASE_URL=postgresql+psycopg://puti:puti_local@localhost:5432/digital_twin
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
APP_ENV=development
# Wajib diganti di staging/production. Buat dengan: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=dev-only-ganti-jwt-secret-key-di-env-minimal-32-karakter
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Batas login gagal: per username, per alamat IP, dan lama jendela hitungannya (menit).
LOGIN_MAX_FAILURES_PER_USER=5
LOGIN_MAX_FAILURES_PER_IP=20
LOGIN_LOCKOUT_MINUTES=15
