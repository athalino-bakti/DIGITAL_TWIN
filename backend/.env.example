APP_NAME=Digital Twin PuTI API
# Konektor Trello API (DIG-119), opsional. Key dan token dari https://trello.com/app-key
TRELLO_API_ENABLED=false
TRELLO_API_KEY=
TRELLO_API_TOKEN=
DATABASE_URL=postgresql+psycopg://puti:puti_local@localhost:5432/digital_twin
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
APP_ENV=development
# Wajib diganti di staging/production. Buat dengan: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=dev-only-ganti-jwt-secret-key-di-env-minimal-32-karakter
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Batas login gagal: per username, per alamat IP, dan lama jendela hitungannya (menit).
LOGIN_MAX_FAILURES_PER_USER=5
LOGIN_MAX_FAILURES_PER_IP=20
LOGIN_LOCKOUT_MINUTES=15
